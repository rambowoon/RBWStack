<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:RBWStack.Avalonia.Views"
             x:Class="RBWStack.Avalonia.Views.SitesView"
             x:Name="SitesRoot">
    <Grid RowDefinitions="Auto,Auto,*" Margin="28,22,28,16">
        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="btn-outline" Command="{Binding ChangeDocumentRootCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Data="{StaticResource IconFolder}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                        <TextBlock Text="Đổi thư mục gốc" />
                    </StackPanel>
                </Button>
                <Button Classes="btn-icon" ToolTip.Tip="Tải lại danh sách" Command="{Binding LoadSitesCommand}">
                    <views:SvgIcon Data="{StaticResource IconRefresh}" Size="16" Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Dự án" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Chọn phiên bản PHP, bật SSL, tên miền ảo và Deploy Demo cho từng dự án" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DockPanel>

        <!-- Search bar with flat SVG search icon -->
        <Border Grid.Row="1" Margin="0,0,0,14" Background="{DynamicResource InputBgBrush}"
                BorderBrush="{DynamicResource BorderBrushMain}" BorderThickness="1" CornerRadius="8">
            <Grid ColumnDefinitions="36,*">
                <views:SvgIcon Grid.Column="0" Data="{StaticResource IconSearch}" Size="15" Stroke="{DynamicResource TextMutedBrush}" />
                <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="0,8,10,8"
                         Text="{Binding SiteSearchText}"
                         Watermark="Tìm theo tên dự án hoặc tên miền..." />
            </Grid>
        </Border>

        <!-- Sites list -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredSites}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card-compact" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,12,*,Auto,8,Auto">
                                <!-- Initials Avatar -->
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                        Background="{Binding AvatarBgHex}">
                                    <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold"
                                               Foreground="{Binding AvatarFgHex}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Name & URL -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                            HorizontalAlignment="Left"
                                            Command="{Binding #SitesRoot.DataContext.OpenSiteUrlCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Data="{StaticResource IconExternal}" Width="11" Height="11" Stretch="Uniform"
                                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                                            <TextBlock Text="{Binding DisplayUrl}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- PHP Version Selector -->
                                <ComboBox Grid.Column="3" Width="130" VerticalAlignment="Center"
                                          ItemsSource="{Binding AvailablePhpVersions}"
                                          SelectedItem="{Binding SelectedPhpVersion}" />

                                <!-- Flat SVG Action Icon Buttons -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="btn-icon" Classes.active-green="{Binding IsSslEnabled}"
                                            ToolTip.Tip="Bật/Tắt SSL (HTTPS)"
                                            Command="{Binding #SitesRoot.DataContext.ToggleSiteSslCommand}"
                                            CommandParameter="{Binding}">
                                        <views:SvgIcon Data="{StaticResource IconLock}" Size="16" Stroke="{Binding $parent[Button].Foreground}" />
                                    </Button>
                                    <Button Classes="btn-icon" Classes.active-green="{Binding IsVHostEnabled}"
                                            ToolTip.Tip="Cấu hình Tên miền ảo (VHost)"
                                            Command="{Binding #SitesRoot.DataContext.OpenSiteVHostCommand}"
                                            CommandParameter="{Binding}">
                                        <views:SvgIcon Data="{StaticResource IconGlobe}" Size="16" Stroke="{Binding $parent[Button].Foreground}" />
                                    </Button>
                                    <Button Classes="btn-icon"
                                            ToolTip.Tip="Deploy Demo Hosting"
                                            Command="{Binding #SitesRoot.DataContext.OpenSiteDeployCommand}"
                                            CommandParameter="{Binding}">
                                        <views:SvgIcon Data="{StaticResource IconRocket}" Size="16" Stroke="{Binding $parent[Button].Foreground}" />
                                    </Button>
                                    <Button Classes="btn-icon"
                                            ToolTip.Tip="Mở bằng VS Code"
                                            Command="{Binding #SitesRoot.DataContext.OpenSiteInCodeCommand}"
                                            CommandParameter="{Binding}">
                                        <views:SvgIcon Data="{StaticResource IconCode}" Size="17" Stroke="{Binding $parent[Button].Foreground}" />
                                    </Button>
                                    <Button Classes="btn-icon"
                                            ToolTip.Tip="Mở thư mục dự án"
                                            Command="{Binding #SitesRoot.DataContext.OpenSiteFolderCommand}"
                                            CommandParameter="{Binding}">
                                        <views:SvgIcon Data="{StaticResource IconFolder}" Size="16" Stroke="{Binding $parent[Button].Foreground}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
