<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RBWStack.Avalonia.Views"
        x:Class="RBWStack.Avalonia.Views.DeployModalWindow"
        Width="720" Height="580"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Title="Deploy Demo Hosting">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="22">
        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button x:Name="BtnOpenDemo" DockPanel.Dock="Right" Classes="btn-outline" IsVisible="False" Click="OnOpenDemoClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <views:SvgIcon Data="{StaticResource IconExternal}" Size="14" Stroke="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Mở trang Demo" />
                </StackPanel>
            </Button>
            <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <views:SvgIcon Data="{StaticResource IconZap}" Size="16" Stroke="{DynamicResource AccentTextBrush}" />
                    <TextBlock Text="DEPLOY DEMO HOSTING" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />
                </StackPanel>
                <TextBlock x:Name="TxtProject" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DockPanel>

        <!-- Form Card -->
        <Border Grid.Row="1" Classes="card-compact" Margin="0,0,0,14" Padding="16">
            <Grid ColumnDefinitions="*,18,220">
                <StackPanel Grid.Column="0" Spacing="12" MinWidth="0">
                    <StackPanel Spacing="5" MinWidth="0">
                        <TextBlock Text="Chọn Server Demo" FontSize="12" FontWeight="SemiBold" />
                        <ComboBox x:Name="CbServer" HorizontalAlignment="Stretch" MinWidth="0" SelectionChanged="OnServerSelectionChanged" />
                    </StackPanel>

                    <StackPanel Spacing="5" MinWidth="0">
                        <TextBlock Text="Tên Database tùy chỉnh (để trống để tự sinh)" FontSize="12" FontWeight="SemiBold" />
                        <TextBox x:Name="TxtDbSuffix" MinWidth="0" Watermark="vd: 620261801326w" />
                    </StackPanel>

                    <Border Background="{DynamicResource CardSubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <TextBlock x:Name="TxtPreviewUrl" FontSize="11.5" Foreground="{DynamicResource AccentTextBrush}" TextTrimming="CharacterEllipsis" />
                    </Border>
                </StackPanel>

                <!-- Right Toggle Switches -->
                <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="*,10,Auto">
                        <TextBlock Grid.Column="0" Text="Kích hoạt SSL (https)" VerticalAlignment="Center" FontSize="12.5" />
                        <ToggleSwitch Grid.Column="2" x:Name="SwSsl" IsChecked="True" IsCheckedChanged="OnSslChanged" />
                    </Grid>
                    <Grid ColumnDefinitions="*,10,Auto">
                        <TextBlock Grid.Column="0" Text="Chỉ deploy Database" VerticalAlignment="Center" FontSize="12.5" />
                        <ToggleSwitch Grid.Column="2" x:Name="SwOnlyDb" />
                    </Grid>
                    <Grid ColumnDefinitions="*,10,Auto">
                        <TextBlock Grid.Column="0" Text="Nén bằng 7-Zip" VerticalAlignment="Center" FontSize="12.5" />
                        <ToggleSwitch Grid.Column="2" x:Name="Sw7Zip" IsChecked="True" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress Bar -->
        <StackPanel Grid.Row="2" x:Name="PnlProgress" IsVisible="False" Spacing="5" Margin="0,0,0,10">
            <TextBlock x:Name="TxtProgress" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Text="Đang chuẩn bị..." />
            <ProgressBar x:Name="PbDeploy" Minimum="0" Maximum="100" Height="6" Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>

        <!-- Console Log -->
        <TextBox Grid.Row="3" x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True"
                 FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                 TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Text="Sẵn sàng deploy" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="BtnCleanup" Classes="btn-outline" Click="OnCleanupClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <views:SvgIcon Data="{StaticResource IconTrash}" Size="14" Stroke="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Dọn dẹp" />
                    </StackPanel>
                </Button>
                <Button Content="Đóng" Classes="btn-outline" Click="OnCloseClick" />
                <Button x:Name="BtnDeploy" Classes="btn-primary" Click="OnDeployClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <views:SvgIcon Data="{StaticResource IconRocket}" Size="15" Stroke="#FFFFFF" />
                        <TextBlock Text="Deploy ngay" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
