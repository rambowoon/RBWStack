<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:RBWStack.Avalonia.Views"
             x:Class="RBWStack.Avalonia.Views.SettingsView"
             x:Name="SettingsRoot">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Margin="28,22,28,48">
            <!-- Header -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="btn-outline" Command="{Binding OpenHostsFileCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="{StaticResource IconHelp}" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                            <TextBlock Text="File Hosts" />
                        </StackPanel>
                    </Button>
                    <Button Classes="btn-primary" Command="{Binding SaveAllSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="{StaticResource IconSave}" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="#FFFFFF" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                            <TextBlock Text="Lưu cài đặt" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Cài đặt chung" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Cấu hình hệ thống và thông tin kết nối Deploy Demo Hosting" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </DockPanel>

            <!-- Section 1: Hệ thống -->
            <Border Classes="card">
                <StackPanel Spacing="18">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#EEF2FF">
                            <views:SvgIcon Data="{StaticResource IconSettings}" Size="19" Stroke="#4F46E5" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Hệ thống" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="Web server mặc định, cổng dịch vụ và hành vi khởi động" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 2-column System Inputs (strict equal 50/50 columns) -->
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0" Spacing="6" MinWidth="0">
                                <TextBlock Text="Web Server mặc định" FontSize="12.5" FontWeight="SemiBold" />
                                <ComboBox HorizontalAlignment="Stretch" MinWidth="0"
                                          ItemsSource="{Binding WebServerOptions}"
                                          SelectedItem="{Binding Settings.DefaultWebServer}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6" MinWidth="0">
                                <TextBlock Text="Đuôi tên miền ảo (VHost Suffix)" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBox HorizontalAlignment="Stretch" MinWidth="0" Text="{Binding Settings.VHostSuffix}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0" Spacing="6" MinWidth="0">
                                <TextBlock Text="Cổng Web (HTTP)" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBox HorizontalAlignment="Stretch" MinWidth="0" Text="{Binding Settings.WebPort}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6" MinWidth="0">
                                <TextBlock Text="Cổng MySQL / MariaDB" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBox HorizontalAlignment="Stretch" MinWidth="0" Text="{Binding Settings.MySqlPort}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0" Spacing="6" MinWidth="0">
                                <TextBlock Text="Cổng PHP FastCGI chính" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBox HorizontalAlignment="Stretch" MinWidth="0" Text="{Binding Settings.PhpFastCgiPort}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6" MinWidth="0">
                                <TextBlock Text="Phím tắt lấy mã màu" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBox HorizontalAlignment="Stretch" MinWidth="0" Text="{Binding Settings.ColorPickerHotkey}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 2x2 Toggle Cards (strict equal 50/50 columns) -->
                    <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,12,Auto">
                        <Border Grid.Row="0" Grid.Column="0" Classes="card-subtle" MinWidth="0">
                            <Grid ColumnDefinitions="*,10,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                                    <TextBlock Text="Khởi động cùng hệ điều hành" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Tự chạy RBWStack khi đăng nhập" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.StartWithWindows}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Classes="card-subtle" MinWidth="0">
                            <Grid ColumnDefinitions="*,10,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                                    <TextBlock Text="Thu nhỏ xuống khay khi đóng" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Dịch vụ vẫn chạy nền" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.MinimizeToTray}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Classes="card-subtle" MinWidth="0">
                            <Grid ColumnDefinitions="*,10,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                                    <TextBlock Text="Tối ưu php.ini tự động" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Upload 2GB, memory 1GB, không timeout + ionCube" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.AutoOptimizePhpIni}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="2" Classes="card-subtle" MinWidth="0">
                            <Grid ColumnDefinitions="*,10,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                                    <TextBlock Text="Tự cấp quyền ghi file hosts" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Dùng cho tên miền ảo (VHost)" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.AutoHostsPermission}" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 2: Quản lý Server Demo (Deploy Hosting) -->
            <Border Classes="card">
                <StackPanel Spacing="16">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="btn-primary" VerticalAlignment="Center"
                                Command="{Binding AddDemoServerCommand}">
                            <TextBlock Text="+ Thêm Server Demo" />
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="38" Height="38" CornerRadius="10" Background="#F3E8FF">
                                <views:SvgIcon Data="{StaticResource IconRocket}" Size="19" Stroke="#7C3AED" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Quản lý Server Demo (Deploy Hosting)" FontSize="15" FontWeight="Bold" />
                                <TextBlock Text="Cấu hình danh sách các máy chủ demo để triển khai dự án 1-click (FTP / DirectAdmin)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- Global DB Naming Rule -->
                    <Border Classes="card-subtle">
                        <Grid ColumnDefinitions="*,12,Auto">
                            <TextBlock Grid.Column="0" Text="Quy tắc tạo Database DirectAdmin (áp dụng chung)" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox Grid.Column="2" Width="260"
                                      ItemsSource="{Binding DbNamingRuleOptions}"
                                      SelectedItem="{Binding Settings.DbNamingRule}" />
                        </Grid>
                    </Border>

                    <!-- Demo Server List -->
                    <ItemsControl ItemsSource="{Binding DemoServers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="card-subtle" Padding="16" Margin="0,0,0,12">
                                    <StackPanel Spacing="14">
                                        <!-- Server Card Header -->
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Classes="btn-outline" IsVisible="{Binding !IsDefault}"
                                                        Command="{Binding #SettingsRoot.DataContext.SetDefaultDemoServerCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Data="{StaticResource IconStar}" Width="13" Height="13" Stretch="Uniform"
                                                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock Text="Đặt mặc định" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="btn-outline"
                                                        Command="{Binding #SettingsRoot.DataContext.QuickPasteDemoServerCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Data="{StaticResource IconClipboard}" Width="13" Height="13" Stretch="Uniform"
                                                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock Text="Dán nhanh" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="btn-outline"
                                                        Command="{Binding #SettingsRoot.DataContext.TestDemoServerCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Data="{StaticResource IconPlug}" Width="13" Height="13" Stretch="Uniform"
                                                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock Text="Test kết nối" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="btn-danger-outline"
                                                        Command="{Binding #SettingsRoot.DataContext.DeleteDemoServerCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Data="{StaticResource IconTrash}" Width="13" Height="13" Stretch="Uniform"
                                                              Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock Text="Xóa" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBox Text="{Binding Name}" FontWeight="Bold" FontSize="14" Width="170" />
                                                <Border CornerRadius="6" Padding="8,4" VerticalAlignment="Center"
                                                        Background="{DynamicResource SuccessSoftBgBrush}"
                                                        BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1"
                                                        IsVisible="{Binding IsDefault}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Data="{StaticResource IconStar}" Width="12" Height="12" Stretch="Uniform"
                                                              Stroke="{DynamicResource SuccessTextBrush}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock Text="MẶC ĐỊNH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding TestStatus}" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- 3-Column Inputs Grid (strict equal 33.3% columns with MinWidth=0) -->
                                        <Grid ColumnDefinitions="*,12,*,12,*" RowDefinitions="Auto,10,Auto">
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" MinWidth="0">
                                                <TextBlock Text="HOST / IP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBox MinWidth="0" Text="{Binding Host}" Watermark="210.2.64.70" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" MinWidth="0">
                                                <TextBlock Text="TÊN MIỀN (MẶC ĐỊNH)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBox MinWidth="0" Text="{Binding Domain}" Watermark="demo.domain.net" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="4" Spacing="4" MinWidth="0">
                                                <TextBlock Text="USERNAME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBox MinWidth="0" Text="{Binding Username}" Watermark="demo92y2026" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4" MinWidth="0">
                                                <TextBlock Text="PASSWORD" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <Grid ColumnDefinitions="*,6,Auto" MinWidth="0">
                                                    <TextBox Grid.Column="0" MinWidth="0" Text="{Binding Password}" PasswordChar="{Binding PasswordChar}" />
                                                    <ToggleButton Grid.Column="2" Width="36" Height="36" CornerRadius="8" Padding="0"
                                                                  IsChecked="{Binding ShowPassword}"
                                                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                        <views:SvgIcon Data="{StaticResource IconEye}" Size="16" Stroke="{DynamicResource TextSecondaryBrush}" />
                                                    </ToggleButton>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4" MinWidth="0">
                                                <TextBlock Text="PORT (DA)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBox MinWidth="0" Text="{Binding DaPort}" Watermark="1111" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="4" Spacing="4" MinWidth="0">
                                                <TextBlock Text="FTP ROOT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBox MinWidth="0" Text="{Binding FtpRoot}" Watermark="/domains/{domain}/public_html" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
