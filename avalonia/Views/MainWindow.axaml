<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RBWStack.Avalonia.Views"
        x:Class="RBWStack.Avalonia.Views.MainWindow"
        Width="1180" Height="740"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Title="RBWStack">

    <Border BorderBrush="{DynamicResource BorderBrushMain}" BorderThickness="1" CornerRadius="12" ClipToBounds="True"
            Background="{DynamicResource AppBgBrush}">
        <Grid RowDefinitions="54,*">
            <!-- ═══ TOP BAR (Draggable) ═══ -->
            <Border Grid.Row="0" Background="{DynamicResource TopBarBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushMain}" BorderThickness="0,0,0,1"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0">
                    <!-- Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#1E1B4B">
                            <Image Source="avares://RBWStack/Assets/app.ico" Width="22" Height="22" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RBWStack" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="{Binding CurrentVersion, StringFormat='{}{0} · Windows · Avalonia'}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Center Status Pill -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource PillNeutralBgBrush}"
                            BorderBrush="{DynamicResource BorderBrushMain}" BorderThickness="1"
                            CornerRadius="16" Padding="14,5">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="{Binding TopStatusText}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Right Controls: Theme + Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="win-ctrl" ToolTip.Tip="Chuyển chế độ Sáng / Tối" Command="{Binding ToggleThemeCommand}">
                            <views:SvgIcon Data="{StaticResource IconSun}" Size="16" Stroke="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                        <Border Width="1" Height="16" Background="{DynamicResource BorderBrushMain}" Margin="4,0" />
                        <Button Classes="win-ctrl" Click="OnMinimizeClick" ToolTip.Tip="Thu nhỏ">
                            <Border Width="11" Height="1.75" Background="{DynamicResource TextSecondaryBrush}" CornerRadius="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Classes="win-ctrl" Click="OnMaximizeClick" ToolTip.Tip="Phóng to / Khôi phục">
                            <views:SvgIcon Data="{StaticResource IconMaximize}" Size="13" Stroke="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                        <Button Classes="win-ctrl" Click="OnCloseClick" ToolTip.Tip="Đóng (thu xuống khay)">
                            <views:SvgIcon Data="{StaticResource IconClose}" Size="14" Stroke="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                        <Button Classes="win-ctrl" Command="{Binding ExitAppCommand}" ToolTip.Tip="Thoát hoàn toàn">
                            <views:SvgIcon Data="{StaticResource IconPower}" Size="15" Stroke="{DynamicResource DangerBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ BODY: LEFT SIDEBAR + MAIN CONTENT ═══ -->
            <Grid Grid.Row="1" ColumnDefinitions="228,*">
                <!-- Left Sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}"
                        BorderBrush="{DynamicResource BorderBrushMain}" BorderThickness="0,0,1,0"
                        Padding="12,14">
                    <Grid RowDefinitions="*,Auto">
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="TỔNG QUAN" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="10,4,0,4" />

                                <Button Classes="nav-item" Classes.active="{Binding IsServicesTab}"
                                        Command="{Binding NavigateCommand}" CommandParameter="services">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Data="{StaticResource IconGrid}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                                        <TextBlock Text="Dịch vụ" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Classes="nav-item" Classes.active="{Binding IsSitesTab}"
                                        Command="{Binding NavigateCommand}" CommandParameter="sites">
                                    <DockPanel Width="180">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource PillNeutralBgBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SitesCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Path Data="{StaticResource IconGlobe}" Width="15" Height="15" Stretch="Uniform"
                                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                                            <TextBlock Text="Dự án" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <Button Classes="nav-item" Classes.active="{Binding IsMailTab}"
                                        Command="{Binding NavigateCommand}" CommandParameter="mail">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Data="{StaticResource IconMail}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                                        <TextBlock Text="Mail Sandbox" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="CÔNG CỤ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="10,14,0,4" />

                                <Button Classes="nav-item" Classes.active="{Binding IsDownloadsTab}"
                                        Command="{Binding NavigateCommand}" CommandParameter="downloads">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Data="{StaticResource IconBox}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                                        <TextBlock Text="Kho tải phần mềm" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Classes="nav-item" Classes.active="{Binding IsSettingsTab}"
                                        Command="{Binding NavigateCommand}" CommandParameter="settings">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Data="{StaticResource IconSettings}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                                        <TextBlock Text="Cài đặt chung" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="HỆ THỐNG" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="10,14,0,4" />

                                <Button Classes="nav-item" Classes.active="{Binding IsProTab}"
                                        Command="{Binding NavigateCommand}" CommandParameter="pro">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Data="{StaticResource IconCrown}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                                        <TextBlock Text="RBW Pro" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Classes="nav-item" Classes.active="{Binding IsUpdateTab}"
                                        Command="{Binding NavigateCommand}" CommandParameter="update">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Data="{StaticResource IconRefresh}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                                        <TextBlock Text="Cập nhật" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Status Card -->
                        <Border Grid.Row="1" Classes="card-subtle" Padding="12" Margin="0,10,0,0">
                            <StackPanel Spacing="8">
                                <DockPanel>
                                    <TextBlock Text="TRẠNG THÁI" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding RunningSummaryText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DockPanel>

                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" IsVisible="{Binding !WebService.IsRunning}" />
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding WebService.IsRunning}" />
                                        <TextBlock Text="Apache / Web" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" IsVisible="{Binding !PhpService.IsRunning}" />
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding PhpService.IsRunning}" />
                                        <TextBlock Text="PHP FastCGI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" IsVisible="{Binding !MySqlService.IsRunning}" />
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding MySqlService.IsRunning}" />
                                        <TextBlock Text="MySQL / MariaDB" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,6,*" Margin="0,4,0,0">
                                    <Button Grid.Column="0" Classes="btn-success" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding StartAllCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Data="{StaticResource IconPlay}" Width="11" Height="11" Stretch="Uniform"
                                                  Stroke="#FFFFFF" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                            <TextBlock Text="Start" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Classes="btn-outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding StopAllCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Data="{StaticResource IconStop}" Width="10" Height="10" Stretch="Uniform"
                                                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                            <TextBlock Text="Stop" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Button Classes="btn-danger-outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding ExitAppCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="{StaticResource IconPower}" Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.75" StrokeLineCap="Round" />
                                        <TextBlock Text="Thoát ứng dụng" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Main Page Content Area -->
                <Grid Grid.Column="1">
                    <views:ServicesView IsVisible="{Binding IsServicesTab}" />
                    <views:SitesView IsVisible="{Binding IsSitesTab}" />
                    <views:MailSandboxView IsVisible="{Binding IsMailTab}" />
                    <views:DownloadsView IsVisible="{Binding IsDownloadsTab}" />
                    <views:SettingsView IsVisible="{Binding IsSettingsTab}" />
                    <views:ProView IsVisible="{Binding IsProTab}" />
                    <views:UpdateView IsVisible="{Binding IsUpdateTab}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
