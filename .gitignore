# Ignore everything by default
*

# Allow the data directory specifically (so git can search inside it)
!data/

# Allow source code & build files
!src/
!src/**
!avalonia/
!avalonia/*/
!avalonia/**
!build.bat
!www/
!www/**

# Ignore heavy directories inside www to prevent disk thrashing
www/**/vendor/
www/**/node_modules/
www/**/upload/
www/**/thumbs/
www/**/.git/
www/**/storage/
www/**/cache/

# Allow specific binaries and configs
!RBWStack.exe
!app.ico
!.gitignore
!data/bridge.php
!data/ioncube/
!data/ioncube/**
!ssl/
!ssl/cacert.pem
!ssl/localhost.pfx

# Avalonia build outputs
avalonia/bin/
avalonia/obj/
avalonia/publish/
RBWStackAvalonia.exe
